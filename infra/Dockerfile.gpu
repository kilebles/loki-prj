# Portable multi-cloud GPU worker image for LOKI Remake (GPUniq, Vast.ai, RunPod, Lambda, bare-metal).
# Uses static Rust uv for reproducible, fast builds with zero vendor lock-in.

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    VIRTUAL_ENV=/opt/loki-venv \
    PATH="/opt/loki-venv/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin" \
    HF_XET_HIGH_PERFORMANCE=1 \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    LOKI_MODELS_DIR=/workspace/models \
    LOKI_BAKED_MODELS_DIR=/opt/loki-models

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        libgl1 \
        libglib2.0-0 \
        openssh-server \
        python3.12 \
        python3.12-venv \
        rsync \
        sudo \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/run/sshd /root/.ssh \
    && chmod 700 /root/.ssh \
    && sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

RUN uv venv --python 3.12 /opt/loki-venv && \
    uv pip install --no-cache --python /opt/loki-venv/bin/python \
        torch==2.9.1 torchvision==0.24.1 torchao==0.15.0 \
        --index-url https://download.pytorch.org/whl/cu128 && \
    uv pip install --no-cache --python /opt/loki-venv/bin/python \
        "git+https://github.com/huggingface/diffusers@d6726f3" \
        transformers==5.14.1 \
        huggingface_hub==1.27.0 \
        hf_xet \
        hf-transfer \
        safetensors==0.8.0 \
        peft==0.18.0 \
        accelerate==1.12.0 \
        tokenizers==0.22.1 \
        av==16.1.0 \
        numpy==2.3.5 \
        Pillow==12.2.0 \
        spandrel \
        spandrel-extra-arches \
        opencv-python-headless \
        ai-edge-litert==2.3.0

# Bake commercial-safe auxiliary models (~650 MB total) so worker cold starts never re-fetch them.
RUN mkdir -p /opt/loki-models/face /opt/loki-models/realesrgan && \
    curl -fsSL -L -o /opt/loki-models/face/GFPGANv1.4.pth \
        "https://github.com/TencentARC/GFPGAN/releases/download/v1.3.4/GFPGANv1.4.pth" && \
    curl -fsSL -L -o /opt/loki-models/face/RestoreFormer++.ckpt \
        "https://github.com/wzhouxiff/RestoreFormerPlusPlus/releases/download/v1.0.0/RestoreFormer++.ckpt" && \
    curl -fsSL -L -o /opt/loki-models/face/face_detection_yunet_2023mar.onnx \
        "https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx" && \
    curl -fsSL -L -o /opt/loki-models/face/selfie_multiclass_256x256.tflite \
        "https://storage.googleapis.com/mediapipe-models/image_segmenter/selfie_multiclass_256x256/float32/latest/selfie_multiclass_256x256.tflite" && \
    curl -fsSL -L -o /opt/loki-models/realesrgan/realesr-general-x4v3.pth \
        "https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/realesr-general-x4v3.pth"

COPY infra/sample_fp8.py infra/face_enhance.py infra/restoreformer_arch.py \
     infra/bootstrap_models.sh infra/entrypoint.sh /opt/loki-app/

RUN chmod +x /opt/loki-app/bootstrap_models.sh /opt/loki-app/entrypoint.sh && \
    printf '%s\n' \
        'export VIRTUAL_ENV=/opt/loki-venv' \
        'export PATH="/opt/loki-venv/bin:/usr/local/bin:${PATH}"' \
        'export HF_XET_HIGH_PERFORMANCE=1' \
        'export HF_HUB_ENABLE_HF_TRANSFER=1' \
        'export LOKI_MODELS_DIR=/workspace/models' \
        'export LOKI_BAKED_MODELS_DIR=/opt/loki-models' \
        > /etc/profile.d/loki.sh && \
    printf '%s\n' \
        'VIRTUAL_ENV=/opt/loki-venv' \
        'PATH=/opt/loki-venv/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin' \
        'HF_XET_HIGH_PERFORMANCE=1' \
        'HF_HUB_ENABLE_HF_TRANSFER=1' \
        >> /etc/environment

EXPOSE 22
WORKDIR /workspace
ENTRYPOINT ["/opt/loki-app/entrypoint.sh"]
